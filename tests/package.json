{
  "name": "sqa-social-media-tests",
  "version": "1.0.0",
  "description": "Testes E2E e de API do SQA Social Media com Playwright",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=e2e",
    "test:local": "node scripts/test-local.cjs",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --project=e2e --headed",
    "test:list": "playwright test --list",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "install:browsers": "playwright install chromium"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
